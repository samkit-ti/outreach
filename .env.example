# Outreach Agent Environment Secrets Template
# Copy this file to .env and fill in real values.
# The .env file is loaded automatically by the container entrypoint.

# =============================================================================
# MODEL PROVIDER (Azure AI Foundry)
# =============================================================================

# Option A: Azure AI Foundry with Entra ID (default)
# No API key needed — uses managed identity or Azure CLI auth locally.
# In Container Apps, use a user-assigned managed identity.
AZURE_FOUNDRY_ENDPOINT=https://ps3labs.openai.azure.com/openai/v1
DEFAULT_MODEL=kimi-k2-6

# Option B: Azure OpenAI with API key
# Uncomment these and comment out the Entra section in config.yaml
# AZURE_OPENAI_API_KEY=your-api-key-here
# AZURE_OPENAI_ENDPOINT=https://ps3labs.openai.azure.com/

# Option C: Alternative providers (OpenRouter, etc.)
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# =============================================================================
# MESSAGING / GATEWAY CREDENTIALS
# =============================================================================

# Discord bot token (only needed if using Discord gateway)
# Get from Discord Developer Portal: https://discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Telegram bot token (only needed if using Telegram gateway)
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=

# WhatsApp Business API credentials (only needed for WhatsApp gateway)
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# =============================================================================
# FOUNDER / ADMIN CONTACTS
# =============================================================================

# These are used for allowed_users in gateway and cron notifications
FOUNDER_EMAIL=samkit@ps3labs.ai
FOUNDER_DISCORD_ID=

# =============================================================================
# CRM & DATA
# =============================================================================

# Hermes home directory inside the container
HERMES_DIR=/app/data

# SQLite database path (default: /app/data/crm.db)
# DB_PATH=/app/data/crm.db

# =============================================================================
# SALES ENRICHMENT APIs (optional — for lead enrichment)
# =============================================================================

# Clearbit for company/person enrichment
# CLEARBIT_API_KEY=

# Apollo.io for contact data
# APOLLO_API_KEY=

# Hunter.io for email verification
# HUNTER_API_KEY=

# =============================================================================
# SECRET FOR INTERNAL API / WEBHOOK (optional)
# =============================================================================

# Used to authenticate incoming webhooks or internal API calls
# INTERNAL_API_SECRET=change-me-to-a-long-random-string
