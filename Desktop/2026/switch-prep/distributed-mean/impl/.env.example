# Host-side defaults for the harness and tests (the compose stack has its own env).
API_URL=http://localhost:8080
DATABASE_URL=postgres://dm:dm@localhost:5433/dm
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=dmadmin
S3_SECRET_KEY=dmsecret
S3_BUCKET=distributed-mean
# Per-worker artificial slowdown for the straggler demo (>= 1.0)
SPEED_FACTOR=1.0
