# Hermes Agent Environment Template
# Copy this to ~/.hermes/.env and fill in your actual values
# NEVER commit the real .env file to git

# ==============================
# Azure AI Foundry (Kimi K2.6)
# ==============================
# For Managed Identity (Entra ID) — RECOMMENDED
# No API key needed! Just assign "Azure AI User" role on the Foundry resource
# to the VM's System-Assigned Managed Identity.
# If NOT using Managed Identity, uncomment and fill:
# AZURE_FOUNDRY_API_KEY=your-azure-key-here
# AZURE_FOUNDRY_BASE_URL=https://your-resource.openai.azure.com/openai/v1

# For Entra ID service principal (fallback):
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret

# ==============================
# Email (Gmail / Outlook)
# ==============================
EMAIL_ADDRESS=your-agent-email@gmail.com
EMAIL_PASSWORD=your-app-password-here
EMAIL_IMAP_HOST=imap.gmail.com
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_PORT=587
EMAIL_POLL_INTERVAL=15

# Comma-separated allowed sender emails
EMAIL_ALLOWED_USERS=your-email@example.com
EMAIL_HOME_ADDRESS=your-email@example.com

# ==============================
# WhatsApp (Baileys bridge)
# ==============================
WHATSAPP_ENABLED=true
WHATSAPP_MODE=bot

# Comma-separated phone numbers (country code, no +)
# Use * to allow all (not recommended for production)
WHATSAPP_ALLOWED_USERS=*

# ==============================
# Discord
# ==============================
DISCORD_BOT_TOKEN=your-discord-bot-token

# ==============================
# Founder Identity
# ==============================
FOUNDER_NAME=Samkit Shah
FOUNDER_EMAIL=your-email@example.com
FOUNDER_DISCORD_ID=your-discord-user-id

# ==============================
# Multi-Business Config
# ==============================
BUSINESS_DIR=/opt/business
ACTIVE_BUSINESS=ps3_labs_ai

# ==============================
# Cost Control
# ==============================
MONTHLY_TOKEN_BUDGET_USD=100
WEEKLY_SPEND_ALERT_THRESHOLD=25

# ==============================
# Directories
# ==============================
HERMES_DIR=/opt/hermes-agent
BEADS_DIR=/opt/hermes-agent/.beads
